rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // University schedule collections: allow read for authenticated/public viewers and write for scheduling and updates
    match /departments/{departmentId} {
      allow read: if true;
      allow write: if true;
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if true;
    }

    match /activities/{activityId} {
      allow read: if true;
      allow write: if true;
    }

    match /deadlines/{deadlineId} {
      allow read: if true;
      allow write: if true;
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if true;
    }

    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if true;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    match /feedback/{feedbackId} {
      allow read: if true;
      allow write: if true;
    }

    match /current_semester/{semesterId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
