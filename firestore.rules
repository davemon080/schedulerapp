rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // University schedule & curriculum collections
    match /departments/{departmentId} {
      allow read: if true;
      allow write: if true;
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if true;
    }

    match /activities/{activityId} {
      allow read: if true;
      allow write: if true;
    }

    match /deadlines/{deadlineId} {
      allow read: if true;
      allow write: if true;
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if true;
    }

    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if true;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if true;

      // User transactions subcollection
      match /transactions/{transactionId} {
        allow read: if true;
        allow write: if true;
      }
    }

    // Root wallet transactions & audit ledger
    match /wallet_transactions/{transactionId} {
      allow read: if true;
      allow write: if true;
    }

    // Semester access grants
    match /semester_access/{accessId} {
      allow read: if true;
      allow write: if true;
    }

    match /feedback/{feedbackId} {
      allow read: if true;
      allow write: if true;
    }

    match /current_semester/{semesterId} {
      allow read: if true;
      allow write: if true;
    }

    match /admin_profiles/{adminId} {
      allow read: if true;
      allow write: if true;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Fallback document match
    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}

